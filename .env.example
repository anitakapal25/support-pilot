# Local development credentials only. Keep real secrets in an untracked .env.
POSTGRES_USER=support
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=support
DATABASE_URL=postgresql+psycopg://support:local-development-only@localhost:5432/support
POSTGRES_PORT=5432
API_PORT=8000

# Demo is development-only. OpenAI mode requires both key and model.
APP_ENV=development
COOKIE_SECURE=false
AGENT_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=
ALLOWED_ORIGINS='["http://localhost:58000","http://localhost:8000","http://localhost:5173"]'

# Re-ingest the complete corpus after changing embedding model/dimensions.
EMBEDDING_PROVIDER=demo
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256
EVIDENCE_COVERAGE=0.7

# Model request budgets (local input estimate includes instructions, context and tools).
MODEL_INPUT_TOKEN_LIMIT=4096
MODEL_OUTPUT_TOKEN_LIMIT=256
# Optional current provider rates, USD / million tokens, for local cost estimates.
# Leave absent when unknown; never use a guessed zero rate for a paid provider.
# MODEL_INPUT_USD_PER_MILLION=
# MODEL_CACHED_INPUT_USD_PER_MILLION=
# MODEL_OUTPUT_USD_PER_MILLION=
# EMBEDDING_USD_PER_MILLION=
# For Compose, pass configured rates explicitly with docker compose run -e NAME=value.
